# URL del API backend
NEXT_PUBLIC_API_URL=http://localhost:8001/api

# Origen público del sitio (para metadataBase, canonical, sitemap y Open Graph).
# En producción usa tu dominio real, p. ej. https://playinone.cl
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Clave con la que se firma la cookie de visitante (pio_vid) en
# src/app/api/consent/route.ts. NO lleva prefijo NEXT_PUBLIC: es server-only y
# nunca debe llegar al navegador, porque quien la tenga puede fabricar
# identificadores válidos. Debe ser EL MISMO valor que el VISITOR_ID_SECRET del
# backend, que verifica esa firma. Vacío = no se emite la cookie y toda la
# medición se queda en el nivel anónimo. Genera: openssl rand -hex 32
VISITOR_ID_SECRET=
